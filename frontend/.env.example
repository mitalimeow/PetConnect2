# Backend API connection endpoint (defaults to http://localhost:5000 in local dev)
VITE_API_BASE_URL=your_backend_api_url_here

# TomTom Developer API Key for geospatial Veterinary Clinics and Shelter Locator searches
VITE_TOMTOM_API_KEY=your_tomtom_api_key_here

# Google OAuth 2.0 Client ID for Google Sign-In authentication
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Firebase Web App configurations (used for Firestore database and Phone Auth verification)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
